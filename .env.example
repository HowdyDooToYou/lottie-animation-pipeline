# lottie-animation-pipeline — environment knobs
# Every coupling has an env override; nothing below is required if the matching
# provider is skipped. Copy to .env (gitignored) or export in your shell/CI.

# ── Provider API keys ─────────────────────────────────────────────────────────
# OpenRouter (openrouter-free / openrouter-cheap lanes). Falls back to the
# Linux keyring (`secret-tool lookup service openrouter`) when unset.
OPENROUTER_API_KEY=

# Google AI Studio key (gemini-api lane). Keyring fallback: `service gemini`.
GEMINI_API_KEY=

# Anthropic (paid last-resort lane; skipped when unset).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=    # default claude-opus-4-8

# ── Provider toggles / endpoints ──────────────────────────────────────────────
# Set to 1 to skip all three Google lanes (antigravity-cli, gemini-api,
# gemini-cli) — the right choice for CI or machines without the CLIs.
LOTTIE_NO_GEMINI=

# Ollama endpoint. Default http://127.0.0.1:21434/v1 is a host-specific WSL2
# bridge — stock Ollama is http://127.0.0.1:11434/v1. Unreachable = lane skipped.
OLLAMA_BASE=

# ── CLI binaries (skipped when the binary doesn't exist) ──────────────────────
AGY_BIN=            # default: ~/.local/bin/agy   (Antigravity CLI)
GEMINI_CLI_BIN=     # default: ~/.local/bin/gemini (legacy Gemini CLI)
ANTIGRAVITY_MODEL=  # display name, e.g. "Gemini 3.5 Flash (Medium)"
AGY_TIMEOUT_MS=     # default 180000
GEMINI_CLI_TIMEOUT_MS=  # default 180000
GEMINI_MODEL=       # gemini-api lane model id
OLLAMA_FAST_MODEL=  # ollama-fast lane model
OLLAMA_SMART_MODEL= # ollama-smart lane model

# ── Render validation ─────────────────────────────────────────────────────────
# puppeteer-core ships NO browser. Autodetect covers Linux paths only
# (/usr/bin/chromium-browser, /usr/bin/chromium, /snap/bin/chromium,
# /usr/bin/google-chrome); on anything else set this explicitly.
CHROMIUM_BIN=
